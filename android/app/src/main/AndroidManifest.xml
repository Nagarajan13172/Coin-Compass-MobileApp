<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every request this app makes goes over the network. The Flutter
         template only declares INTERNET in the debug and profile manifests
         "for development"; without it here the RELEASE build's sockets fail
         with EACCES and every API call dies. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Merged in anyway by androidx.biometric and local_auth_android; declared
         explicitly so the app lock's requirements are readable in this file.
         USE_FINGERPRINT is the pre-API-28 spelling. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>

    <!-- 7.4 — device alerts. Android 13 (API 33) made posting notifications a
         runtime permission; below that it is granted at install. Asked for when
         the user turns the feature on in Settings, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The periodic background check reschedules itself after a reboot, so it
         survives the phone being restarted. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- USE_FINGERPRINT implies a *required* fingerprint feature, which would
         hide the app from devices without a sensor. The app lock is optional,
         so say so. -->
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false"/>

    <!-- Phase 6.3. android:allowBackup was NOT DECLARED here, so it defaulted
         to TRUE, and Android Auto Backup includes filesDir — which holds the
         PersistCookieJar's mt_session cookie (documented in 6.1's threat
         model) and, from 6.3 on, up to 14 days of the owner's figures as
         plaintext JSON under api-cache/. Backup is switched off outright
         rather than filtered: none of this app's local state is worth
         restoring to a new device (the cache is regenerable, the cookie should
         not travel, and the app-lock PIN verifier is deliberately
         per-install). The API-31+ rules file below says the same thing for
         cloud backup and device-to-device transfer.
         MUST be verified with `aapt2 dump xmltree` on the SIGNED artifact, not
         on this file — 6.1 found a release-only manifest bug exactly that way. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
