<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window for API < 31. Android 12+ ignores this in favour of the
     splash screen API configured in values-v31/styles.xml.
     `splash_background` is night-aware, so this one file covers both themes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
