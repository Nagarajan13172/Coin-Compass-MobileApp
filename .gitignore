# ---------------------------------------------------------------
# CoinCompass — project additions
# ---------------------------------------------------------------

# Build output (any subproject, not just the root)
**/build/
.gradle/

# Machine-specific SDK paths (Flutter/Android toolchain locations)
local.properties
**/local.properties

# Secrets / environment
.env
.env.*
!.env.example
*.pem
*.p12
*.p8
*.mobileprovision

# Signing material — never commit these
key.properties
**/*.jks
**/*.keystore
android/app/upload-keystore.jks

# Firebase / service configs (uncomment if you add Firebase)
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist

# Flutter tooling
.fvm/
.flutter-plugins
.flutter-plugins-dependencies
**/.dart_tool/
.packages
.pub-cache/

# Test & coverage output
coverage/
test/failures/
**/failures/
*.lcov

